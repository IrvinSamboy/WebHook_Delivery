# Copia este archivo a .env (make up lo hace por ti si no existe).
# Estos valores son solo para desarrollo local.

APP_ENV=development

POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# Los hosts "postgres" y "redis" son los nombres de los servicios de docker-compose.
DATABASE_URL=postgresql+psycopg://relay:relay@postgres:5432/relay
REDIS_URL=redis://redis:6379/0

# Clave que cifra los secretos de los endpoints. make up genera una al crear el .env.
# Si se pierde, esos secretos no se pueden recuperar.
ENCRYPTION_KEY=
