# Copia este archivo a .env (make up lo hace por ti si no existe).
# Estos valores son solo para desarrollo local.

APP_ENV=development

# Puerto del host donde se publica la API (8000 si no se indica).
# API_PORT=8001

POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# Los hosts "postgres" y "redis" son los nombres de los servicios de docker-compose.
DATABASE_URL=postgresql+psycopg://relay:relay@postgres:5432/relay
REDIS_URL=redis://redis:6379/0

# Clave que cifra los secretos de los endpoints. make up genera una al crear el .env.
# Si se pierde, esos secretos no se pueden recuperar.
ENCRYPTION_KEY=

# Espera tras el primer fallo de una entrega; se duplica en cada reintento.
# 30 en producción (unas 4 h para los 10 intentos); 2 en desarrollo (unos 17 min).
BACKOFF_BASE_SECONDS=2

# Protección contra SSRF: por defecto no se envía a direcciones internas
# (localhost, redes privadas, metadatos de la nube). En desarrollo hay que
# permitirlo, porque el receptor de prueba es http://receiver:9000.
# En producción, quitar esta línea o ponerla a false.
ALLOW_PRIVATE_URLS=true

# Mensajes por minuto que puede crear cada aplicación (POST /v1/messages).
RATE_LIMIT_PER_MINUTE=600
